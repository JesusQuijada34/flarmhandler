/* Etiquetas de la cabecera, el icono cuadrado y el badge informativo.
   El acento del SO entra por __ACCENT__. */

#TitleLabel {
    color: #5F5F5F;
    font-size: 12px;
    padding-left: 12px;
}
#AppTitle {
    font-size: 24px;
    font-weight: 600;
    color: #1B1B1B;
}
#AppMeta {
    color: #5F5F5F;
    font-weight: 500;
    font-size: 14px;
}
#AppVersion {
    color: #8A8A8A;
    font-size: 12px;
}

/* Contenedor del icono: cuadrado con el color de acento del SO */
#AppIcon {
    background-color: __ACCENT__;
    border-radius: 6px;
}

/* Icono informativo "i" del pie */
#InfoBadge {
    background-color: transparent;
    color: #5F5F5F;
    border: 1px solid #C9C9C9;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
}
